# Pinned versions for the cluster and the CLI tools (update-setup-01)
# Also read by Docker Compose in cli/ (cli/.env is a symlink to this file).
# Platform service versions are pinned in platformservices/**/kustomization.yaml
# (helmCharts[].version, or the release tag in a URL).
CLUSTER_NAME=dev
KIND_VERSION=v0.33.0
KIND_NODE_IMAGE=kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed
# kubectl on the host and in cli/ matches the node image version
KUBECTL_VERSION=v1.36.4
CPK_VERSION=v0.11.1
GATEWAY_API_VERSION=v1.6.2
K9S_VERSION=v0.51.0
LAZYDOCKER_VERSION=v0.25.2
# update-setup-02: lvmd on the host (the TopoLVM chart is pinned in platformservices/topolvm)
TOPOLVM_VERSION=v0.41.1
HARBOR_VERSION=v2.15.2
# Harbor stays off 80/443: those host ports are reserved for the cluster ingress.
# The HTTPS port is part of the registry name (harbor.kind.local:3443/library/...).
HARBOR_HTTP_PORT=3030
HARBOR_HTTPS_PORT=3443
# update-setup-03: Keycloak as the central identity provider, external to the cluster
KEYCLOAK_VERSION=26.7.3
KEYCLOAK_CONFIG_CLI_VERSION=6.5.1-26
KEYCLOAK_HOSTNAME=keycloak.kind.local
KEYCLOAK_HTTPS_PORT=8443
KEYCLOAK_REALM=localdev
